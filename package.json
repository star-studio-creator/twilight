{
  "name": "@star-studio/twilight",
  "version": "0.3.0",
  "description": "轻量化的 Svelte 组件库 / A lightweight Svelte component library",
  "homepage": "https://github.com/star-studio-creator/twilight#readme",
  "license": "MIT",
  "author": "Star Studio (https://github.com/star-studio-creator)",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/star-studio-creator/twilight.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "lint": "biome check",
    "typecheck": "svelte-check --fail-on-warnings --diagnostic-sources 'js,svelte'",
    "format": "biome format --write",
    "ci:lint": "biome ci",
    "ci:typecheck": "svelte-check --fail-on-warnings --diagnostic-sources 'js,svelte' --output machine",
    "build": "svelte-package -i src"
  },
  "exports": {
    "./index.css": "./dist/index.css",
    "./alert": {
      "svelte": "./dist/alert/index.js",
      "types": "./dist/alert/index.d.ts"
    },
    "./badge": {
      "svelte": "./dist/badge/index.js",
      "types": "./dist/badge/index.d.ts"
    },
    "./button": {
      "svelte": "./dist/button/index.js",
      "types": "./dist/button/index.d.ts"
    },
    "./card": {
      "svelte": "./dist/card/index.js",
      "types": "./dist/card/index.d.ts"
    },
    "./checkbox": {
      "svelte": "./dist/checkbox/index.js",
      "types": "./dist/checkbox/index.d.ts"
    },
    "./disclosure": {
      "svelte": "./dist/disclosure/index.js",
      "types": "./dist/disclosure/index.d.ts"
    },
    "./field": {
      "svelte": "./dist/field/index.js",
      "types": "./dist/field/index.d.ts"
    },
    "./input": {
      "svelte": "./dist/input/index.js",
      "types": "./dist/input/index.d.ts"
    },
    "./link": {
      "svelte": "./dist/link/index.js",
      "types": "./dist/link/index.d.ts"
    },
    "./modal": {
      "svelte": "./dist/modal/index.js",
      "types": "./dist/modal/index.d.ts"
    },
    "./placeholder": {
      "svelte": "./dist/placeholder/index.js",
      "types": "./dist/placeholder/index.d.ts"
    },
    "./select": {
      "svelte": "./dist/select/index.js",
      "types": "./dist/select/index.d.ts"
    },
    "./slider": {
      "svelte": "./dist/slider/index.js",
      "types": "./dist/slider/index.d.ts"
    },
    "./sticky": {
      "svelte": "./dist/sticky/index.js",
      "types": "./dist/sticky/index.d.ts"
    },
    "./switch": {
      "svelte": "./dist/switch/index.js",
      "types": "./dist/switch/index.d.ts"
    },
    "./tabs": {
      "svelte": "./dist/tabs/index.js",
      "types": "./dist/tabs/index.d.ts"
    },
    "./theme": {
      "default": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./theme/default.css": "./dist/theme/default.css",
    "./toast": {
      "default": "./dist/toast/index.js",
      "types": "./dist/toast/index.d.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "sv-router": "^0.17.0",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.7.0",
    "svelte": "^5.55.0",
    "svelte-sonner": "^1.1.0",
    "tailwindcss": "^4.2.0"
  }
}
