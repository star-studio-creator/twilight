{
  "name": "@star-studio/twilight",
  "version": "0.0.0",
  "description": "轻量化的 Svelte 组件库 / A lightweight Svelte component library",
  "homepage": "https://github.com/star-studio-creator/twilight",
  "license": "MIT",
  "author": "Star Studio (https://github.com/star-studio-creator)",
  "files": [
    "dist"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/star-studio-creator/twilight.git"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "svelte-package -i src && rm -rf .svelte-kit",
    "check": "biome check",
    "format": "biome format --write",
    "ci": "biome ci",
    "publish": "bun publish"
  },
  "exports": {
    "./button": {
      "import": "./dist/button.js",
      "svelte": "./dist/button.js",
      "types": "./dist/button.d.ts"
    },
    "./switch": {
      "import": "./dist/switch.js",
      "svelte": "./dist/switch.js",
      "types": "./dist/switch.d.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "sv-router": "^0.13.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "@lucide/svelte": "^0.562.0",
    "clsx": "^2.1.0",
    "svelte": "^5.46.0",
    "tailwindcss": "^4.1.0"
  }
}
