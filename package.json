{
  "name": "@star-studio/twilight",
  "version": "0.0.0",
  "description": "轻量化的 Svelte 组件库 / A lightweight Svelte component library",
  "homepage": "https://github.com/star-studio-creator/twilight",
  "license": "MIT",
  "author": "Star Studio (https://github.com/star-studio-creator)",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/star-studio-creator/twilight.git"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "svelte-package -i src && rm -rf .svelte-kit",
    "check": "biome check",
    "format": "biome format --write",
    "ci": "biome ci",
    "publish": "bun publish"
  },
  "exports": {
    "./alert": {
      "svelte": "./dist/alert/index.js",
      "types": "./dist/alert/index.d.ts"
    },
    "./badge": {
      "svelte": "./dist/badge/index.js",
      "types": "./dist/badge/index.d.ts"
    },
    "./button": {
      "svelte": "./dist/button/index.js",
      "types": "./dist/button/index.d.ts"
    },
    "./card": {
      "svelte": "./dist/card/index.js",
      "types": "./dist/card/index.d.ts"
    },
    "./checkbox": {
      "svelte": "./dist/checkbox/index.js",
      "types": "./dist/checkbox/index.d.ts"
    },
    "./disclosure": {
      "svelte": "./dist/disclosure/index.js",
      "types": "./dist/disclosure/index.d.ts"
    },
    "./field": {
      "svelte": "./dist/field/index.js",
      "types": "./dist/field/index.d.ts"
    },
    "./input": {
      "svelte": "./dist/input/index.js",
      "types": "./dist/input/index.d.ts"
    },
    "./modal": {
      "svelte": "./dist/modal/index.js",
      "types": "./dist/modal/index.d.ts"
    },
    "./select": {
      "svelte": "./dist/select/index.js",
      "types": "./dist/select/index.d.ts"
    },
    "./slider": {
      "svelte": "./dist/slider/index.js",
      "types": "./dist/slider/index.d.ts"
    },
    "./switch": {
      "svelte": "./dist/switch/index.js",
      "types": "./dist/switch/index.d.ts"
    },
    "./theme": {
      "default": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "sv-router": "^0.14.0",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "@lucide/svelte": "^0.577.0",
    "svelte": "^5.53.0",
    "tailwindcss": "^4.2.0"
  }
}
