{
  "exclude": ["dist/", "node_modules/"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@demo/*": ["./demo/*"]
    }
  }
}
